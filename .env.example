# ======================================================================
#  Coinbase Smart Copy Trader — configuración (copia a .env)
#  NUNCA subas .env ni secrets/ al repositorio.
# ======================================================================

# --- Seguridad --------------------------------------------------------
# Token para cambiar ajustes desde el panel (genera uno: python -c "import secrets;print(secrets.token_urlsafe(32))")
ADMIN_TOKEN=
# Clave para firmar la autorización del modo real (cámbiala)
APP_SECRET=cambia-esto-por-un-valor-aleatorio
CORS_ORIGINS=http://localhost:3000
# Notificaciones de fallos (opcional, gratis): p. ej. https://ntfy.sh/<tema-privado>
NOTIFY_WEBHOOK_URL=
# Secreto HMAC para tus señales propias por webhook (opcional)
WEBHOOK_SECRET=

# --- Coinbase (claves CDP, algoritmo ECDSA, permisos SOLO view + trade) -
# Opción A (recomendada con Docker): fichero secrets/cdp_api_key.json → COINBASE_API_KEY_FILE
# Opción B: variables (el PEM con \n literales)
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=
# COINBASE_API_KEY_FILE=./secrets/cdp_api_key.json

# --- Modo real (desactivado por defecto) -------------------------------
LIVE_TRADING_ALLOWED=false
# Permitir reanudar el modo real tras un reinicio (autorización firmada con caducidad)
LIVE_PERSIST_AUTH=false
LIVE_PERSIST_AUTH_HOURS=24

# --- Cartera y riesgo (valores por defecto; editables en el panel dentro de los topes) ---
INITIAL_CAPITAL_EUR=100
MIN_CASH_RESERVE_EUR=30
MAX_TOTAL_EXPOSURE_EUR=70
MAX_ASSET_EXPOSURE_EUR=20
MAX_OPEN_POSITIONS=4
MAX_NEW_TRADES_PER_DAY=3
MAX_DAILY_LOSS_EUR=2
MAX_DRAWDOWN_EUR=10
MAX_ROUND_TRIP_COST_PCT=1.0
MIN_TRADE_EUR=5
ORDER_STYLE=maker
MAKER_ORDER_TTL_SECONDS=300
MAX_SIGNAL_AGE_SECONDS=120
MAX_QUOTE_AGE_SECONDS=15
MAX_SPREAD_PCT=0.30
MIN_TRADER_SCORE=60
ALLOWED_ASSETS=BTC,ETH
HL_INCLUDE_PERP_LONGS=true
POLL_INTERVAL_SECONDS=30

# Comisiones usadas hasta leer las reales de tu cuenta (estimación conservadora "Intro")
DEFAULT_MAKER_FEE=0.0060
DEFAULT_TAKER_FEE=0.0120
